# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Anthropic Claude API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database
DATABASE_URL=sqlite:///./chat_analyzer.db

# Schedule (cron format or days)
# Default: Monday and Thursday at 10:00 AM
ANALYSIS_SCHEDULE_DAY_1=0  # Monday (0 = Monday, 6 = Sunday)
ANALYSIS_SCHEDULE_TIME_1=10:00
ANALYSIS_SCHEDULE_DAY_2=3  # Thursday
ANALYSIS_SCHEDULE_TIME_2=10:00

# Admin User ID (your Telegram user ID)
ADMIN_USER_ID=your_telegram_user_id

# Analysis Settings
ANALYSIS_DAYS_BACK=7  # How many days of messages to analyze
MIN_MESSAGES_FOR_ANALYSIS=10  # Minimum messages needed for analysis
