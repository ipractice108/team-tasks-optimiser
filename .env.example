# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# AI Provider Configuration
# Choose one: groq (recommended, free), gemini (free tier), ollama (local, free), claude (paid)
AI_PROVIDER=groq

# AI API Key (not needed for ollama)
# For groq: Get free key at https://console.groq.com/
# For gemini: Get free key at https://makersuite.google.com/app/apikey
# For claude: Get paid key at https://console.anthropic.com/
AI_API_KEY=your_api_key_here

# AI Model (optional, defaults are provided)
# Groq models: llama-3.1-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# Gemini models: gemini-pro, gemini-1.5-flash
# Ollama models: llama3.1, mistral, codellama (must be pulled first)
# Claude models: claude-3-5-sonnet-20241022, claude-3-haiku-20240307
AI_MODEL=llama-3.1-70b-versatile

# Database
DATABASE_URL=sqlite:///./chat_analyzer.db

# Schedule (cron format or days)
# Default: Monday and Thursday at 10:00 AM
ANALYSIS_SCHEDULE_DAY_1=0  # Monday (0 = Monday, 6 = Sunday)
ANALYSIS_SCHEDULE_TIME_1=10:00
ANALYSIS_SCHEDULE_DAY_2=3  # Thursday
ANALYSIS_SCHEDULE_TIME_2=10:00

# Admin User ID (your Telegram user ID)
ADMIN_USER_ID=your_telegram_user_id

# Analysis Settings
ANALYSIS_DAYS_BACK=7  # How many days of messages to analyze
MIN_MESSAGES_FOR_ANALYSIS=10  # Minimum messages needed for analysis
